@@ -513,6 +513,9 @@
 case_ "any change in analysis/ (here outside k1's closure) stops the recheck (ops_r3's guard)" "analysis/, harness/ or configs/defaults.yaml differ in the working tree from the Mac's HEAD" 1 zsh $Q
 reset; echo "# y" >> $T/repo/configs/defaults.yaml
 case_ "configs/defaults.yaml changed: no recheck" "differ in the working tree from the Mac's HEAD" 1 zsh $Q
+reset; (cd $T/repo && echo "# z" >> configs/defaults.yaml && $G commit -q -am "defaults (sandbox)")
+case_ "DH-O1: a commit to configs/defaults.yaml (read by today's checks) stops the recheck" "configs/defaults.yaml differs from the pin's" 1 zsh $Q
+chk "DH-O1: and nothing of the run entered runs/" is "$(nfiles "$T/repo/runs/*")" 0
 reset; (cd $T/repo && echo "# y" >> harness/config.py && $G commit -q -am "harness/config.py moved")
 case_ "RD-O1: a commit to harness/config.py (in the recheck's closure, not in mac_checks) stops the recheck" "harness/ differs in the working tree from $PINH" 1 zsh $Q
