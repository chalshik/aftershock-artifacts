--- a/docs/probe/20261113_reg20/ops/common.sh
+++ b/docs/probe/20261113_reg20/ops/common.sh
@@ -526,6 +526,9 @@
   # RD-O1: all of harness/ (the recheck's closure holds harness/{__init__,checks,config,workload}.py) equals the checks' commit.
   git diff --quiet $CHECKS_COMMIT -- harness/ || { MSG="harness/ differs in the working tree from $CHECKS_COMMIT, whose harness/ the recheck runs (RD-O1; the arm A hold)"; return 2; }
   git diff --quiet HEAD -- analysis harness configs/defaults.yaml || { MSG="analysis/, harness/ or configs/defaults.yaml differ in the working tree from the Mac's HEAD"; return 2; }
+  # rule F round 3 (DH-O1): today's checks merge configs/defaults.yaml beneath each run's config (harness/checks.py:48),
