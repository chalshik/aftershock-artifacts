@@ -17,6 +17,9 @@
 H=chalshik@${VM_HOST:-100.83.53.50}
 K=(-i $HOME/.ssh/id_ed25519_vllm -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
 MIN_FREE_KB=2097152                      # 2 GB free on the VM before a launch (about 240 MB per run)
+CONTROL_MIN_FREE_KB=1048576              # rule F round 3 (DH1): a control's floor, RUNBOOK:26's 4 x 240 MB per launch (4 x 242,736 kB,
+                                         # REG-19's seed 15 burst run, rounded up to 1 GiB): a burst run launched at MIN_FREE_KB leaves
+                                         # room for its control, which runs right after it (decisions.md:4054), unless it wrote > 1 GiB
 MAX_ATTEMPTS=2                           # REG-20 (decisions.md 2026-11-12 [REG], standing instructions): one rerun
 MAX_POWER_LOSSES=2                       # ruling 8(b): losses after a power-off that are not counted, per config
 NOFILE_MIN=4096                          # REG-20: below this open-file limit in the launching shell, stop and ask
--- a/docs/probe/20261113_reg20/ops/launch.sh
+++ b/docs/probe/20261113_reg20/ops/launch.sh
@@ -49,7 +49,8 @@
 [[ $APPS == 0 ]] || { echo "STOP: GPU compute process present"; exit 2; }
 [[ $VMH == $PIN && $DIRTY == 0 ]] || { echo "STOP: VM tree '$VMH' dirty='$DIRTY', pin $PIN"; exit 2; }
 [[ -n $BOOT && $BOOT == $(<$ST/session_boot_id.txt) ]] || { echo "STOP: the VM rebooted since the session probe (boot id '$BOOT')"; exit 2; }
-[[ $FREE == <-> ]] && (( FREE >= MIN_FREE_KB )) || { echo "STOP: only '$FREE' kB free on the VM"; exit 2; }
+NEED=$MIN_FREE_KB; [[ $CFG == ${C}* ]] && NEED=$CONTROL_MIN_FREE_KB   # DH1: a control, right after its burst run, has the lower floor
+[[ $FREE == <-> ]] && (( FREE >= NEED )) || { echo "STOP: only '$FREE' kB free on the VM, $NEED needed for $CFG"; exit 2; }
 if [[ -n $OPEN ]]; then
   [[ $NOFR == <-> ]] && (( NOFR >= NOFILE_MIN )) || { echo "STOP: the open-file limit after 'ulimit -n $NOFILE_SET' reads '$NOFR' (hard '$NOFH'); REG-20 needs at least $NOFILE_MIN for the open arm: stop and ask"; exit 2; }
 fi
