+def test_table_end_to_end_on_stuck_seeds_written_like_the_harness(tmp_path, monkeypatch):
+    """Rule F d1 r2, DJ3 (DG9 completed): the outcome that changes C2's status the other way goes through `row` and
+    `table` on records of the harness's shape (never-admitted sessions, unsent placeholders, turns cut at the
+    deadline): the labels are stuck, the slot invariant holds, the hand-over gaps are no harness_fault, and three
+    stuck seeds split 2 / 1 across the KV classes give `stuck_split`."""
+    runs = tmp_path / "runs"
+    for sd in D.D1["seeds"]:
+        _write(runs / D.D1["controls"][sd], _cfg(f"stage2_control_l1pl350cl_r2.0_w3000_s{sd}"),
+               make_run(capped=False), True)
+        _write(runs / D.D1["uncapped"][sd], _cfg(f"burst_l1pl350cl_r2.0_w3000_s{sd}"),
+               make_run(reuse_after=0.0, q_after=100.0, kv_after=0.95, burst=True, capped=False), True)
+    for sd, kv in ((15, 0.5), (16, 0.95), (17, 0.5)):
+        _write(runs / f"20261120-1{sd}000_{D.config_name(sd)}", D.resolved(sd, CAP), harness_like(CAP, kv_after=kv),
+               True)
+    for sd in (18, 19):
+        _write(runs / f"20261120-1{sd}000_{D.config_name(sd)}", D.resolved(sd, CAP), make_run(burst=True), True)
+    _seal_env(tmp_path, monkeypatch, ["## 2026-11-13 · [RESULT] REG-19 (P0 at λ = 2.0): supports"])
+    monkeypatch.setattr(L, "RUNS", runs)
+    monkeypatch.setenv("AFTERSHOCK_UNSEAL", "D1")
+    t = D.table()
+    by = {r["seed"]: r for r in t["rows"]}
+    assert [by[s]["label"] for s in D.D1["seeds"]] == ["stuck_kv_free", "stuck_kv_full", "stuck_kv_free", "recovered",
+                                                       "recovered"]
+    for s in (15, 16, 17):
+        assert by[s]["slots"]["holds"] and by[s]["slots"]["idle_share"] < 0.01 and by[s]["slots"]["max_held"] == CAP
+        assert by[s]["label_values"]["cap_backlogged"] is True and by[s]["waits"]["all"]["n_never_admitted"] > 0
+        assert by[s]["onset"] == "undefined"
+    assert t["decision"] == "stuck_split" and t["k_stuck"] == 3 and t["below_reg19"] is False
+    json.dumps(t, default=str)
+
