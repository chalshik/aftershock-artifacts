+def harness_like(cap, s_warm=0.5, s_cold=2.0, kv_after=0.5, handover=0.002):
+    """Rule F d1 r2, DJ3: a capped run whose records have the shape harness/loadgen.py writes when the cap binds and
+    the server stays cold. Sessions every 4 s, 8 closed-loop turns 5 s apart (planned), FIFO slots (`SessionCap`),
+    handed over `handover` s after the last reply; a request sent from 900 s on takes s_cold s (else s_warm) and a
+    later turn sent then reuses nothing; the burst (2.4/s over [900, 1080), 30 s each) bypasses the cap. Deadline =
+    last planned + 300 s. A session never admitted keeps only `t_arrived` on turn 0 and sends nothing; a turn not sent
+    by the deadline is an 'unfinished' placeholder (t_sent None); one in flight at the deadline is 'unfinished' with
+    t_sent set."""
+    import heapq
+    arrivals = np.arange(0.0, 4080.0, 4.0)
+    deadline = arrivals[-1] + 35.0 + 300.0
+    free, rows, rid, prev_admit = [0.0] * cap, [], 0, 0.0
+    blank = lambda sid, k, a: dict(request_id=rid, session_id=sid, turn=k, t_planned=a + 5 * k, t_released=None,
+                                   prompt_tokens_planned=2176 + 256 * k, output_tokens_planned=128, t_sent=None,
+                                   t_first_token=None, t_end=None, prompt_tokens=None, output_tokens=None,
+                                   cached_tokens=None, status="unfinished", error=None)
+    for sid, a in enumerate(arrivals):
+        e = heapq.heappop(free)
+        admit = max(a, e + (handover if e > 0 else 0.0), prev_admit)
+        prev_admit = admit
+        if admit > deadline:
+            for k in range(8):
+                r = blank(sid, k, a)
+                if k == 0:
+                    r["t_arrived"] = a
+                rows.append(r)
+                rid += 1
+            heapq.heappush(free, e)
+            continue
+        t_rel, last = admit, deadline
+        for k in range(8):
+            r = blank(sid, k, a)
+            if k == 0:
+                r["t_arrived"], r["t_admitted"] = a, admit
+            if t_rel <= deadline:
+                svc = s_cold if t_rel >= 900 else s_warm
+                tf, te = t_rel + 0.3 * svc, t_rel + svc
+                r.update(t_released=t_rel, t_sent=t_rel)
+                if te <= deadline:
+                    share = 1.0 if t_rel < 900 else 0.0
+                    r.update(t_first_token=tf, t_end=te, prompt_tokens=2176 + 256 * k, output_tokens=128,
+                             cached_tokens=0 if k == 0 else int(share * (2176 + 256 * (k - 1))), status="ok")
+                    last, t_rel = te, te + 5.0
+                else:
+                    r["t_first_token"] = tf if tf <= deadline else None
+                    last, t_rel = deadline, math.inf
+            else:
+                last = deadline          # the chain sleeps past the deadline and holds its slot until the cancel
+            rows.append(r)
+            rid += 1
+        heapq.heappush(free, last)
+    for j, tb in enumerate(np.arange(900.0, 1080.0, 1 / 2.4)):
+        rows.append({**blank(100000 + j, 0, tb), "prompt_tokens_planned": 2944, "t_sent": tb, "t_first_token": tb + 1.0,
+                     "t_end": tb + 30.0, "prompt_tokens": 2944, "output_tokens": 128, "cached_tokens": 0,
+                     "status": "ok"})
+        rid += 1
+    q = pd.DataFrame(rows)
+    q["ttft"] = q.t_first_token - q.t_released.fillna(q.t_planned).astype(float)
+    t = np.arange(0.0, deadline + 1.0)
+    burst, after = (t >= 900) & (t < 1080), t >= 1080
+    m = pd.DataFrame({"t": t, "vllm:prefix_cache_hits_total": np.cumsum(np.where(after, 0.0, 80.0)),
+                      "vllm:prefix_cache_queries_total": 100.0 * (t + 1),
+                      "vllm:num_requests_waiting": np.where(burst, 40.0, 0.0), "vllm:num_requests_running": 10.0,
+                      "vllm:kv_cache_usage_perc": np.where(burst, 0.97, np.where(after, kv_after, 0.15))})
+    return {"cfg": None, "metrics": m, "requests": q, "dir": None}
+
