+    watch. RE3: a 40 s zero of the waiting gauge early in the drop while the total line is still owed is not the drain
+    K3 measures."""
+    cfg = C.burst_cfg(15, 5400.0)
+    monkeypatch.setitem(C.REG24, "seed", 15)
