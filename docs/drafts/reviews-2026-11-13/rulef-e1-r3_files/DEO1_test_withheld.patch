 def test_e1_seal_lifts_alone(no_result):
-    no_result.write_text("## 2026-11-15 · [RESULT] E1: floor 1.75\n")
+    no_result.write_text("## 2026-11-15 · [OPS] E1: the floor may be computed (E0's [REG] is committed)\n"
