+#!/bin/zsh
+# REG-20 arm A: moves the VM's tree back to the pin 1cface7 (README step 4; the operations decision draft 3, point 18;
+# ported from E1's vm_checkout.sh, rule F round 2's RC-O10). It is the one REG-20 script that changes the VM's tree (no
+# other one does). Usage, from the Mac, after E1's end entry is committed:
+#   zsh docs/probe/20261113_reg20/ops/vm_checkout.sh
+# Refuses, changing nothing on the VM: when a Mac-side check fails (common.sh `mac_checks`); before HEAD's
+# docs/decisions.md holds every heading arm A's queue needs, E1's end entry among them, or while E1's queue lock exists
+# (`gate_in_log`, which calls `e1_ended`); while REG-20's own queue lock exists; while a compute process is on the GPU
+# or any tmux session exists on the VM; when the VM's tree is dirty, or its commit is not one that the pin is an
+# ancestor of on the Mac. The move is backward (from E1's ce5f842, or from a later HEAD deployed after E1's end entry,
+# to its ancestor 1cface7), and point 18 covers it from such a commit only; anything else is the owner's. Then, on the
+# VM only, `git checkout --detach <pin>`: no push and no fetch (E1's checkout fetched a descendant of the pin into the
+# VM's clone; the checkout fails otherwise); read back the commit, the dirty count and uv.lock's blob, and run a
+# dry-run `uv sync`, which must show no change. Everything goes to a time-stamped probe file in
+# docs/probe/20261113_reg20/, to be committed with an [OPS] entry. No root command, no run, no other change on the VM.
+source ${0:A:h}/common.sh
+die() { echo "STOP: $1"; exit ${2:-2}; }
+mac_checks || exit 2
+gate_in_log || die "$MSG"
+[[ ! -e $ST/queue.lock ]] || die "REG-20's queue lock exists ($ST/queue.lock): no checkout under a queue"
+rd=$(ssh $K $H "echo '# vm_checkout read (agent, read-only)'; nvidia-smi --query-compute-apps=pid --format=csv,noheader | wc -l; cd ~/aftershock-artifacts && git rev-parse HEAD && git status --short | wc -l; echo '# tmux:'; tmux ls 2>&1 || true") || die "the VM could not be read"
+apps=${${(f)rd}[2]// /}; vh=${${(f)rd}[3]}; vd=${${(f)rd}[4]// /}
+[[ $apps == 0 ]] || die "a compute process is on the GPU ('$apps')"
+print -r -- "$rd" | sed -n '/# tmux:/,$p' | grep -q "no server running\|No such file or directory\|error connecting" || die "a tmux session exists on the VM: no checkout while a run may be in progress"
+[[ $vd == 0 ]] || die "the VM's tree is dirty ('$vd' entries): the owner decides"
+mkdir -p $PROBE_DIR
+stamp; out=$PROBE_DIR/vm_checkout_$REPLY.txt
+[[ ! -e $out ]] || die "$out exists"
+print -r -l -- "# REG-20 arm A: vm_checkout (agent, under the operations decision, point 18). scripts $SC; Mac HEAD $(git -C $R rev-parse HEAD); pin $PIN" "before $vh dirty $vd" > $out
+if [[ $vh == $PIN ]]; then echo "already_at_pin" >> $out; cat $out; echo "VM ALREADY AT THE PIN $PIN, clean"; exit 0; fi
+git -C $R cat-file -e "${vh}^{commit}" 2> /dev/null && git -C $R merge-base --is-ancestor $PIN $vh || die "the VM's commit '$vh' is not one the pin $PIN is an ancestor of on the Mac: point 18 covers the move back only from such a commit; the owner decides"
+ssh $K $H "cd ~/aftershock-artifacts && git checkout -q --detach $PIN && echo \"head \$(git rev-parse HEAD)\" && echo \"dirty \$(git status --short | wc -l)\" && echo \"lock_blob \$(git hash-object uv.lock)\"" >> $out 2>&1 || die "the checkout on the VM failed (see ${out:t})"
+dry=$(ssh $K $H "cd ~/aftershock-artifacts && ~/.local/bin/uv sync --frozen --extra server --dry-run 2>&1") || die "the VM's dry-run sync failed"
+n_chg=$(print -r -- "$dry" | grep -c '^ [-+~] ')
+print -r -l -- "# uv sync --frozen --extra server --dry-run on the VM:" "$dry" "uv_changes $n_chg" >> $out
+cat $out
+[[ $(grep '^head ' $out | awk '{print $2}') == $PIN && $(grep '^dirty ' $out | awk '{print $2}') == 0 ]] || die "the VM's tree is not the pin, clean, after the checkout (see ${out:t})"
+[[ $(grep '^lock_blob ' $out | awk '{print $2}') == $(git -C $R rev-parse ${PIN}:uv.lock) ]] || die "the VM's uv.lock is not the pin's after the checkout"
+[[ $n_chg == 0 ]] || die "the dry-run sync on the VM would change $n_chg packages: the owner decides before any run"
+echo "VM AT THE PIN $PIN, clean; uv.lock the pin's; next: session_probe.sh (SET=1 if allowed; RENEW=1 only with a decisions.md entry)"
