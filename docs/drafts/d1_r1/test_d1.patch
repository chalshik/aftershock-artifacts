+VERDICT = {"baseline_s": 600, "watch_s": 3000, "end_s": 600, "min_baseline_pf": 0.98, "recovered_pf_drop": 0.02,
+           "recovered_hit_drop": 0.06, "recovered_q_excess": 1.0, "stuck_pf_drop": 0.10, "stuck_hit_drop": 0.06,
+           "pf_climb": 0.05, "hit_climb": 0.06, "drain_horizon_s": 3600}
+
+
+def make_run(reuse_after=1.0, q_after=0.0, kv_after=0.5, wait=lambda t: 0.0, hit_after=None, base_pf=1.0,
+             reuse_prev=None, gauge_gap=None):
+    """Sessions start every 4 s (0.25/s), 8 turns 5 s apart (2 req/s); before the burst's end (1080 s) every later turn
+    reuses its whole previous prompt; after it, `reuse_after` (`reuse_prev` in the previous window [2880, 3480) if
+    given). Turn 0 of the session arriving at t waits `wait(t)` s at the cap (np.inf: never admitted). Server: hit 0.8,
+    no line, KV 0.5 before; after, `hit_after` (default reuse_after), `q_after`, `kv_after`."""
+    t = np.arange(0.0, 4081.0)
+    after = t >= 1080
+    h = reuse_after if hit_after is None else hit_after
+    m = pd.DataFrame({"t": t, "vllm:prefix_cache_hits_total": np.cumsum(np.where(after, 100 * h, 80.0)),
+                      "vllm:prefix_cache_queries_total": 100.0 * (t + 1),
+                      "vllm:num_requests_waiting": np.where(after, q_after, 0.0), "vllm:num_requests_running": 20.0,
+                      "vllm:kv_cache_usage_perc": np.where(after, kv_after, 0.5)})
+    if gauge_gap is not None:
+        m.loc[(m.t > gauge_gap[0]) & (m.t < gauge_gap[1]), "vllm:kv_cache_usage_perc"] = np.nan
+    rows, rid = [], 0
+    for sid, t0 in enumerate(np.arange(0.0, 4040.0, 4.0)):
+        w = wait(t0)
+        for k in range(8):
+            ts = t0 + 5 * k
+            prev = 2176 + 256 * (k - 1)
+            share = 1.0 if ts + 0.3 < 1080 else (reuse_prev if reuse_prev is not None and 2880 <= ts + 0.3 < 3480
+                                                  else reuse_after)
+            ok = not (ts < 900 and rid % 10 == 0 and base_pf < 1.0)
+            r = {"request_id": rid, "session_id": sid, "turn": k, "t_planned": ts, "t_sent": ts, "t_first_token": ts + 0.3,
+                 "t_end": ts + 2.0, "status": "ok", "ttft": 0.3 if ok else 5.0, "prompt_tokens": 2176 + 256 * k,
+                 "prompt_tokens_planned": 2176 + 256 * k, "cached_tokens": 0 if k == 0 else int(share * prev)}
+            if k == 0:
+                r["t_arrived"], r["t_admitted"] = t0, (np.nan if np.isinf(w) else t0 + w)
+            rows.append(r)
+            rid += 1
+    cfg = {"trigger": {"kind": "burst", "at_s": 900, "duration_s": 180, "prompt_tokens": 2944}, "verdict": VERDICT,
+           "slo": {"ttft_s": 1.0}, "checks": {"max_scrape_gap_s": 2.0}, "workload": {"duration_s": 4080}}
+    return {"cfg": cfg, "metrics": m, "requests": pd.DataFrame(rows), "dir": Path("synthetic")}
+
