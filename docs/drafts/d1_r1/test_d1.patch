+def lab(**kw):
+    return D.label(make_run(**kw))["label"]
+
+
+def test_warm_server_and_empty_cap_queue_is_recovered():
+    out = D.label(make_run(wait=lambda t: 300.0 if 900 <= t < 1500 else 0.0))
+    assert out["label"] == "recovered" and out["cap_queue"]["end"]["mean"] == 0.0
+    assert out["windows"] == {"base": (300.0, 900.0), "end": (3480.0, 4080.0)}
+
+
+def test_warm_server_with_a_shrinking_cap_queue_is_recovered_cap_draining():
+    w = lambda t: max(0.0, 400.0 - 350.0 * (t - 900.0) / 3180.0) if t >= 900 else 0.0
+    out = D.label(make_run(wait=w))
+    assert out["label"] == "recovered_cap_draining" and out["cap_queue"]["end"]["slope"] < 0
+
+
+def test_warm_server_with_a_growing_cap_queue_is_server_only():
+    assert lab(wait=lambda t: 0.4 * (t - 900.0) if t >= 900 else 0.0) == "server_only"
+    assert lab(wait=lambda t: np.inf if t >= 3000 else 0.0) == "server_only"     # never admitted from 3000 s
+
+
+def test_cold_reuse_with_an_empty_server_line_is_stuck_not_recovered():
+    """The cap bounds the server's line, so an empty line must not make a cold cache a recovery."""
+    assert lab(reuse_after=0.0, q_after=0.0, kv_after=0.6) == "stuck_kv_free"
+    assert lab(reuse_after=0.0, q_after=5.0, kv_after=0.95) == "stuck_kv_full"
+
+
+def test_a_climb_rules_out_stuck():
+    assert lab(reuse_after=0.5, reuse_prev=0.3, kv_after=0.6) == "rewarming"
+    assert lab(reuse_after=0.3, reuse_prev=0.3, kv_after=0.6) == "stuck_kv_free"
+
+
+def test_the_label_reads_reuse_not_the_hit_counter():
+    assert lab(hit_after=0.6) == "recovered"                       # extra first turns lower hit, not reuse
+    assert lab(reuse_after=0.0, hit_after=0.85, kv_after=0.6) == "stuck_kv_free"
