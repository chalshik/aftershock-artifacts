+def test_end_to_end_cap_from_a_fake_control_then_a_capped_burst_run(tmp_path):
+    from analysis.load import load_run
+    from tests.test_e2e_fake import run_fake
+    wl = {"rate": 12.0, "duration_s": 24, "warmup_s": 5, "output_tokens": 8,
+          "sessions": {"turns": 3, "closed_loop": True, "turn_gap_s": {"dist": "exponential", "mean": 2.0}}}
+    verdict = {**VERDICT, "baseline_s": 3, "watch_s": 10, "end_s": 3, "control_t_s": 10}
+    common = {"slo": {"ttft_s": 1.0}, "verdict": verdict}
+    (tmp_path / "c").mkdir()
+    (tmp_path / "b").mkdir()
+    control = load_run(run_fake(tmp_path / "c", workload=wl, **common))
+    cap = D.cap_value(control)
+    assert isinstance(cap, int) and cap >= 1
+    burst = {"kind": "burst", "at_s": 8, "duration_s": 2, "rate": 6.0, "prompt_tokens": 64}
+    run_dir = run_fake(tmp_path / "b", workload={**wl, "sessions": {**wl["sessions"], "cap": cap}}, trigger=burst,
+                       **common)
+    assert json.loads((run_dir / "checks.json").read_text())["valid"]
+    run = load_run(run_dir)
+    assert D.label(run)["label"] in D.LABELS
+    assert D.slots(run, cap)["holds"] and not D.harness_fault(D.slots(run, cap))
+    assert D.cap_queue(run, np.array([0.0]))[0] == 0
+    w = D.waits(run)
+    assert w["all"]["n_sessions"] >= w["before_burst"]["n_sessions"] >= 1
+    assert len(D.spans(run)) == D.D1["n_spans"]
+    from analysis.load import verdict            # `row`'s readout: load.verdict runs on a capped run's records
+    assert isinstance(verdict(run)["verdict"], str)
