+def test_peak_is_cap_max_with_its_time_and_the_pre_burst_peak():
+    p = D.peak(SMALL, before=10.0)
+    assert p["value"] == capa.max_sessions_in_service(SMALL) == 3 and p["t_first"] == 2.5 and p["before"] == 3
+    assert D.peak(SMALL, before=2.0)["before"] == 2
+
