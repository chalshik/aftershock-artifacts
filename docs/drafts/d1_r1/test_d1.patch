+def test_bad_baseline_and_missing_values():
+    assert lab(base_pf=0.9) == "bad_baseline"
+    assert lab(reuse_after=0.0, kv_after=0.6, gauge_gap=(3500, 3600)) == "unclear"   # KV does not cover the end window
+    r = make_run()
+    r["requests"] = r["requests"].drop(columns=["t_arrived", "t_admitted"])
+    assert D.label(r)["label"] == "unclear"                                     # no cap queue: not a capped run
