+def test_write_configs_writes_new_files_only(tmp_path):
+    caps = {15: 26, 16: 25, 17: 28, 18: 24, 19: 27}
+    f = tmp_path / "caps.txt"
+    f.write_text('{"seed": 15, "cap": 26}\n' + json.dumps({"caps": {str(k): v for k, v in caps.items()}}) + "\n")
+    assert D.caps_from_file(f) == caps
+    paths = D.write_configs(D.caps_from_file(f), tmp_path)
+    assert [p.name for p in paths] == [f"burst_l1pl350cl_r2.0_w3000_s{s}_cap.yaml" for s in D.D1["seeds"]]
+    assert [p.read_text() for p in paths] == [D.config_text(s, caps[s]) for s in D.D1["seeds"]]
+    with pytest.raises(FileExistsError):
+        D.write_configs(caps, tmp_path)
+    with pytest.raises(ValueError):
+        D.write_configs({15: 26}, tmp_path / "x")
