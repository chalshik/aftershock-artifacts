+@pytest.mark.parametrize("labels, want", [
+    (["recovered"] * 5, "supports"),
+    (["recovered", "recovered", "recovered_cap_draining", "unclear", "rewarming"], "supports"),
+    (["recovered"] * 4 + ["stuck_kv_free"], "mixed"),             # one seed stuck under the cap blocks `supports`
+    (["stuck_kv_free"] * 3 + ["recovered"] * 2, "refutes"),
+    (["stuck_kv_full"] * 3 + ["recovered"] * 2, "cap_did_not_cut"),
+    (["server_only"] * 3 + ["recovered"] * 2, "admission_only"),
+    (["recovered", "recovered", "unclear", "unclear", "bad_baseline"], "mixed"),
+    (["recovered", "recovered"], "too_few"),
+    (["recovered", "recovered", "harness_fault", "harness_fault", "recovered"], "supports"),
+    (["recovered", "harness_fault", "harness_fault", "harness_fault", "recovered"], "too_few"),
+])
+def test_outcome_rules(labels, want):
+    assert D.outcome(labels)["decision"] == want
+
+
+def test_outcome_bounds():
+    o = D.outcome(["recovered"] * 5)
+    assert o["k_cut"] == 5 and o["k_stuck"] == 0 and o["n"] == 5
+    assert o["cp_upper_stuck"] == pytest.approx(1 - 0.05 ** 0.2, abs=1e-6)          # 0.451
+    assert o["cp_lower_cut"] == pytest.approx(0.05 ** 0.2, abs=1e-6) and o["mcnemar_p"] == pytest.approx(1 / 32)
+    o = D.outcome(["recovered"] * 4 + ["stuck_kv_free"])
+    assert o["cp_upper_stuck"] == pytest.approx(0.6574, abs=1e-3) and o["mcnemar_p"] == pytest.approx(1 / 16)
+    o = D.outcome(["harness_fault"] + ["recovered"] * 4)
+    assert o["harness_faults"] == 1 and o["n"] == 4
+    o = D.outcome(["server_only"] * 3 + ["recovered", "recovered_cap_draining"])
+    assert o["decision"] == "admission_only" and o["k_cut"] == 2 and o["k_cut_server_side"] == 5
