+def test_the_capped_folders_match_no_other_registrations_pattern():
+    from analysis import gate, k1, k3, k3w
+    names = [f"20261120-000000_{D.config_name(s)}" for s in D.D1["seeds"]]
+    others = ([gate.reg19_spec(s)[k] for s in D.D1["seeds"] for k in ("control", "burst")]
+              + [k1.closed_pattern(s) for s in D.D1["seeds"]] + [k1.open_pattern(2.0, s) for s in D.D1["seeds"]]
+              + [k3.REG21["batch2_pattern"], k3w.REG21["batch2_pattern"]] + [p for reg, p, _ in W.SEALS if reg != "D1"])
+    assert not [(n, p) for n in names for p in others if fnmatch.fnmatchcase(n, p)]
+    assert all(fnmatch.fnmatchcase(n, D.run_pattern(s)) for n, s in zip(names, D.D1["seeds"]))
+    for sd, name in D.D1["controls"].items():                                 # REG-19's ten are not D1's
+        assert not fnmatch.fnmatchcase(name, D.run_pattern(sd))
+        assert not fnmatch.fnmatchcase(D.D1["uncapped"][sd], D.run_pattern(sd))
