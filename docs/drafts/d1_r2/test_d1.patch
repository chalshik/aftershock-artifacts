+def test_trace_t1c_cold_reuse_with_a_growing_cap_queue_is_stuck():
+    """T1c: reuse 0, the cap's queue growing to an end mean of tens of sessions: stuck_kv_free at KV 0.5."""
+    out = D.label(make_run(reuse_after=0.0, q_after=0.0, kv_after=0.5, wait=lambda t: 0.1 * (t - 900.0) if t >= 900
+                           else 0.0))
+    assert out["cap_queue"]["end"]["mean"] > 50 and out["cap_queue"]["end"]["slope"] > 0
+    assert out["cap_backlogged"] is True and out["label"] == "stuck_kv_free"
