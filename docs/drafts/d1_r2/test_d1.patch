+def test_backlogged_needs_a_slope_only_above_the_baseline():
+    v = VERDICT
+    lvl = lambda base, end, slope: {"base": {"mean": base, "slope": 0.0}, "end": {"mean": end, "slope": slope}}
+    assert D._backlogged(lvl(0.0, 0.5, math.nan), v) is False          # at its baseline: no slope needed
+    assert D._backlogged(lvl(0.0, 5.0, math.nan), v) is None           # above it, whether it drains is unknown
+    assert D._backlogged(lvl(0.0, 5.0, 0.01), v) is True
+    assert D._backlogged(lvl(0.0, 5.0, -0.01), v) is False             # empties in 500 s <= 3600 s
+    assert D._backlogged(lvl(0.0, 100.0, -0.01), v) is True            # 10,000 s > 3600 s: not draining
