+def test_onset_class_separates_the_bursts_own_transient_from_a_formed_cold_state():
+    """Rule F d1 r1, DG10: a cut seed is `never_cold`, `burst_only` (cold only in spans that start before the last
+    burst request ended), `formed_then_cleared` (a cold span starting at or after the exit), or `undefined`."""
+    v = VERDICT
+    sp = lambda i, reuse: {"span": (1080.0 + 300 * i, 1380.0 + 300 * i), "reuse": reuse, "server_rate": 1.75}
+    warm = [sp(i, 1.0) for i in range(10)]
+    assert D.onset_class(D.load_reading(warm, None, 1.0, v, 1200.0)) == "never_cold"
+    burst_only = [sp(0, 0.0)] + warm[1:]
+    assert D.onset_class(D.load_reading(burst_only, None, 1.0, v, 1200.0)) == "burst_only"
+    formed = [sp(0, 0.0), sp(1, 0.0), sp(2, 0.0)] + warm[3:]
+    lr = D.load_reading(formed, None, 1.0, v, 1200.0)
+    assert lr["reading"] == "in_window" and [c["after_exit"] for c in lr["cold"]] == [False, True, True]
+    assert D.onset_class(lr) == "formed_then_cleared"
+    assert D.onset_class(D.load_reading(formed, None, 1.0, v, math.nan)) == "undefined"      # exit unknown
+    assert D.onset_class(D.load_reading([sp(i, 0.0) for i in range(10)], None, 1.0, v, 1200.0)) == "undefined"
+    rows = [{"label": "recovered", "onset": "never_cold"}, {"label": "recovered_cap_draining", "onset": "burst_only"},
+            {"label": "recovered", "onset": "formed_then_cleared"}, {"label": "partial", "onset": "never_cold"}]
+    assert D.onset_split(rows) == {"never_cold": 1, "burst_only": 1, "formed_then_cleared": 1, "undefined": 0}
