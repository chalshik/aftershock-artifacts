+def test_predicted_matrix_is_the_exact_enumeration():
+    p = D.D1["prediction"]
+    assert set(p) == set(D.LABELS) | {"harness_fault"} and sum(p.values()) == pytest.approx(1.0)
+    m = D.predicted_matrix()
+    assert sum(m["decision"].values()) == pytest.approx(1.0) and sum(m["p_k_cut"]) == pytest.approx(1.0)
+    from itertools import product                         # brute force over ordered draws, n = 3
+    labs, brute = sorted(p), {}
+    for combo in product(labs, repeat=3):
+        w = math.prod(p[x] for x in combo)
+        d = D.outcome(list(combo))["decision"]
+        brute[d] = brute.get(d, 0.0) + w
+    small = D.predicted_matrix(n=3)["decision"]
+    assert set(small) == set(brute) and all(small[k] == pytest.approx(brute[k]) for k in brute)
+    with pytest.raises(ValueError):
+        D.predicted_matrix({"recovered": 0.5})
