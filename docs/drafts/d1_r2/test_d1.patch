+def test_cold_reuse_needs_the_caps_backlog_to_be_stuck():
+    """Rule F d1 r1, DG1: the cap holds the server's line near 0, so a cold reuse with no line at the server or at the
+    cap is `partial` (the system carries its load at a lower reuse), never stuck and never recovered."""
+    out = D.label(make_run(reuse_after=0.0, q_after=0.0, kv_after=0.6))
+    assert out["label"] == "partial" and out["cap_queue"]["end"]["mean"] == 0.0 and out["cap_backlogged"] is False
+    assert lab(reuse_after=0.0, q_after=0.0, kv_after=0.6, wait=GROW) == "stuck_kv_free"
+    assert lab(reuse_after=0.0, q_after=5.0, kv_after=0.95, wait=GROW) == "stuck_kv_full"
+    assert lab(reuse_after=0.0, kv_after=0.95, wait=DRAIN) == "partial"           # backlogged, but draining
+
+
+def test_trace_t1_lower_reuse_without_any_backlog_is_partial():
+    """T1: reuse 0.93 after the burst against 1.00 before, no line anywhere, KV 0.5: not stuck (was stuck_kv_free)."""
+    out = D.label(make_run(reuse_after=0.93, q_after=0.0, kv_after=0.5))
+    assert out["reuse"]["base"] == pytest.approx(1.0) and out["reuse"]["end"] == pytest.approx(0.93, abs=1e-3)
+    assert out["label"] == "partial"
+    assert D.outcome(["partial"] * 3 + ["recovered"] * 2)["decision"] == "mixed"
+
