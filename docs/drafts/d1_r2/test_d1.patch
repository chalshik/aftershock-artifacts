+def test_cap_queue_counts_sessions_between_arrival_and_admission():
+    x = D.cap_queue(SMALL, np.array([0.5, 11.5, 12.1, 12.3, 19.0]))
+    assert list(x) == [0, 1, 0, 1, 1]          # session 3 waits [11, 12); session 4 from 12.2 to the end
+    assert np.isnan(D.cap_queue({**SMALL, "requests": SMALL["requests"].drop(columns=["t_arrived"])}, [1.0])).all()
