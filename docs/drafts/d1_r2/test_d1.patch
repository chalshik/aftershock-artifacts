+def _seal_env(tmp_path, monkeypatch, headings):
+    d = tmp_path / "decisions.md"
+    d.write_text("".join(h + "\n" for h in headings))
+    monkeypatch.setattr(W, "DECISIONS", d)
+    monkeypatch.delenv("AFTERSHOCK_UNSEAL", raising=False)
+    return d
+
