+def test_slots_invariant_and_idle_share():
+    s = D.slots(SMALL, cap=3)
+    assert s["max_held"] == 3 and s["holds"] is True
+    assert D.slots(SMALL, cap=2)["holds"] is False
+    assert 0.0 <= s["idle_share"] <= 1.0
+    assert D.harness_fault(s) is (s["idle_share"] > D.D1["max_idle_share"])
+    assert D.harness_fault({"holds": False, "idle_share": 0.0}) is True                 # over the cap
+    assert D.harness_fault({"holds": True, "idle_share": 0.2}) is True                  # a slot left free while waiting
+    assert D.harness_fault({"holds": True, "idle_share": 0.01}) is False
