+def test_d1_seal_covers_its_five_names_and_lifts_only_on_its_result(tmp_path, monkeypatch):
+    """Rule F d1 r1, DG3 (trace T3): the caps entry's heading, `[RESULT] D1 caps ...`, `[RESULT] D1: ...` and
+    `[RESULT] D1-caps` lift nothing; only `## <date> · [RESULT] D1 (C2, session cap)...` does."""
+    d = _seal_env(tmp_path, monkeypatch, [
+        "## 2026-11-14 · [REG] D1 (C2, session cap): draft", "- names [RESULT] D1 (C2, session cap) in a body line",
+        "## 2026-11-15 · [RESULT] D1 caps (registered computation on REG-19's five controls): 26, 25, 28, 24, 27",
+        "## 2026-11-15 · [RESULT] D1 caps: 26, 25, 28, 24, 27", "## 2026-11-15 · [RESULT] D1: cap values",
+        "## 2026-11-15 · [RESULT] D1-caps", "## 2026-11-15 · [OPS] D1: caps computed",
+        "## 2026-11-15 · [RESULT] D10: x", "## 2026-11-15 · [RESULT] D2 (C2, caching off): x",
+        "## 2026-11-16 · [CORR] [RESULT] D1 (C2, session cap) quoted"])
+    names = [f"20261120-000000_{D.config_name(s)}" for s in D.D1["seeds"]]
+    assert [W.sealed_by(n) for n in names] == ["D1"] * 5
+    assert W.sealed_by("20261120-000000_burst_l1pl350cl_r2.0_w3000_s14_cap") is None
+    assert W.sealed_by("20261112-061951_burst_l1pl350cl_r2.0_w3000_s15") != "D1"
+    monkeypatch.setenv("AFTERSHOCK_UNSEAL", "D1")
+    assert W.sealed_by(names[0]) is None
+    monkeypatch.delenv("AFTERSHOCK_UNSEAL")
+    assert W.sealed_by(names[0]) == "D1"
+    d.write_text(d.read_text() + "## 2026-11-20 · [RESULT] D1 (C2, session cap): supports, 5 of 5\n")
+    assert W.sealed_by(names[0]) is None
