+def test_which_broad_globs_take_in_the_capped_folders_once_d1s_seal_lifts():
+    """Rule F d1 r1, DG-O6, stated as a test: `gate.SURGE["pattern"]` (surge_table) and k3.reg21_table(1)'s
+    `*_l1pl350cl_*` match the capped names; k3's batch 1 and REG-22's batch 1 keep only their listed run ids, so their
+    tables do not change; `gate.sweep_rows` and `tables.sweep_table` keep sweep runs only (no `sweep_parent` here)."""
+    from analysis import c2, gate, k3
+    names = [f"20261120-000000_{D.config_name(s)}" for s in D.D1["seeds"]]
+    assert all(fnmatch.fnmatchcase(n, gate.SURGE["pattern"]) for n in names)
+    assert all(fnmatch.fnmatchcase(n, "*_l1pl350cl_*") for n in names)
+    assert not set(names) & (set(k3.REG21["batch1"]) | set(c2.REG22["runs"]))
+    assert "sweep_parent" not in D.resolved(15, 27) or D.resolved(15, 27)["sweep_parent"] is None
