+def _write(folder: Path, cfg: dict, run: dict | None, valid: bool, failed=()):
+    """A run folder as harness/run.py leaves it, from a synthetic run (None: an invalid attempt's empty records)."""
+    folder.mkdir(parents=True)
+    (folder / "config.yaml").write_text(yaml.safe_dump({**cfg, "run_id": folder.name}))
+    (folder / "checks.json").write_text(json.dumps({"valid": valid, "failed": list(failed)}))
+    (folder / "env.json").write_text("{}")
+    for f in ("events.jsonl", "trigger.jsonl"):
+        (folder / f).write_text("")
+    if run is None:
+        for f in ("requests.jsonl", "metrics.jsonl", "gpu.jsonl"):
+            (folder / f).write_text("")
+        return
+    q = run["requests"].drop(columns=["ttft"])
+    with open(folder / "requests.jsonl", "w") as out:
+        for rec in q.to_dict("records"):
+            out.write(json.dumps({k: (None if isinstance(v, float) and math.isnan(v) else v) for k, v in rec.items()})
+                      + "\n")
+    with open(folder / "metrics.jsonl", "w") as out:
+        for rec in run["metrics"].to_dict("records"):
+            vals = {k: v for k, v in rec.items() if k != "t" and not (isinstance(v, float) and math.isnan(v))}
+            out.write(json.dumps({"t": rec["t"], "values": vals}) + "\n")
+    with open(folder / "gpu.jsonl", "w") as out:
+        for t in np.arange(0.0, 4081.0, 5.0):
+            out.write(json.dumps({"t": float(t), "util_pct": 90, "sm_clock_mhz": 1800.0, "power_w": 340.0,
+                                  "temp_c": 60.0}) + "\n")
+
