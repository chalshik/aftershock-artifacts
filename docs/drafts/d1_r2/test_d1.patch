+    assert D.load_reading([warm] * 10, None, 1.0, v)["reading"] == "never_cold"
+    assert D.load_reading([cold(1.75)] * 2 + [warm] * 8, [cold(1.8)] * 10, 1.0, v)["reading"] == "in_window"
+    got = D.load_reading([cold(1.75), cold(1.5)] + [warm] * 8, [cold(1.8)] * 10, 1.0, v)
+    assert got["reading"] == "below_floor" and got["rewarm_span"] == 2 and got["cold"][0]["uncapped_server_rate"] == 1.8
+    assert D.load_reading([cold(1.75)] * 10, None, 1.0, v)["reading"] == "no_rewarm"
+    assert D.load_reading([{"reuse": math.nan, "server_rate": 1.7}] + [warm] * 9, None, 1.0, v)["reading"] == "undefined"
+    assert D.load_reading([warm] * 10, None, math.nan, v)["reading"] == "undefined"
